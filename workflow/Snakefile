def _qc_outputs_for_subset(subset):
    """All QC metrics and key derivative files for one data subset."""
    prefix = OUT_DIR / subset
    files = []

    # ── QC metrics (from initialFilter.sh) ──
    if INPUT_IS_PER_CHROMOSOME:
        for CHR in CHROMOSOMES:
            files.extend([
                prefix / f"initial_{CHR}.smiss",
                prefix / f"initial_{CHR}.vmiss",
                prefix / f"MAF_check_{CHR}.afreq",
                prefix / f"f1.f2_{CHR}.hardy",
                prefix / f"f1.f2_{CHR}.het",
            ])
    else:
        files.extend([
            prefix / "initial.smiss",
            prefix / "initial.vmiss",
            prefix / "MAF_check.afreq",
            prefix / "f1.b38.f2.hardy",
            prefix / "f1.b38.f2.het",
        ])

    # ── pgen backbone ──
    if INPUT_IS_PER_CHROMOSOME:
        for CHR in CHROMOSOMES:
            files.extend([
                prefix / f"f1_{CHR}.pgen",
                prefix / f"f1.ldpruned_{CHR}.pgen",
                prefix / f"f1.f2_{CHR}.pgen",
            ])
        # Crossmap produces per-chromosome f1.b38_{CHR}.pgen in this mode;
        # there is no single-file f1.b38.pgen / f1.b38.f2.pgen merge.
        files.extend(
            prefix / f"f1.b38_{CHR}.pgen" for CHR in CHROMOSOMES
        )
        # b38 LD-pruned backbone comes from the standalone crossmapLdPrunedToB38.
        files.append(prefix / "f1.b38.ldpruned.pgen")
    else:
        files.append(prefix / "f1.pgen")
        files.extend([
            prefix / "f1.b38.pgen",
            prefix / "f1.b38.ldpruned.pgen",
            prefix / "f1.b38.f2.pgen",
            prefix / "f1.b38.f2.ldpruned.pgen",
        ])

    # ── Relatedness / GRM ──
    files.extend([
        prefix / "f1.b38.ldpruned.unrelated.pgen",
        prefix / "f1.b38.ldpruned.unrelated_ids.txt",
        prefix / "f1.b38.ldpruned.grm.bin",
        prefix / "f1.b38.ldpruned.grm.id",
        prefix / "f1.b38.ldpruned.grm.N.bin",
        prefix / "f1.b38.ldpruned.unrelated.ldpruned.pgen",
        prefix / "f1.b38.ldpruned.unrelated.ldpruned.grm.bin",
        prefix / "f1.b38.ldpruned.unrelated.ldpruned.grm.id",
        prefix / "f1.b38.ldpruned.unrelated.ldpruned.grm.N.bin",
    ])

    # ── Internal PCA ──
    if config.get("internalPCA", {}).get("method", "plink2") in ("plink2", "both"):
        files.extend([
            prefix / "internal_pca_plink2.eigenvec",
            prefix / "internal_pca_plink2.eigenval",
        ])

    # ── QC plots ──
    if INPUT_IS_PER_CHROMOSOME:
        for CHR in CHROMOSOMES:
            files.extend([
                prefix / "figures" / f"smiss_{CHR}.svg",
                prefix / "figures" / f"vmiss_{CHR}.svg",
                prefix / "figures" / f"hwe_histogram_{CHR}.svg",
                prefix / "figures" / f"het_distribution_{CHR}.svg",
            ])
    else:
        files.extend([
            prefix / "figures" / "smiss.svg",
            prefix / "figures" / "vmiss.svg",
            prefix / "figures" / "hwe_histogram.svg",
            prefix / "figures" / "het_distribution.svg",
        ])
    files.append(prefix / "figures" / "relatedness_histogram.svg")

    return files


rule all:
    input:
        # ── Global ancestry classification ──
        expand(
            OUT_DIR / "01-globalAncestry" / "keep_{ANC}.txt", ANC=get_provided_ancestries()
        ) if has_provided_ancestry() else [],
        lambda wildcards: (
            [OUT_DIR / "01-globalAncestry" / "refRefPCscores.sscore",
             OUT_DIR / "01-globalAncestry" / "sampleRefPCscores.sscore",
             OUT_DIR / "01-globalAncestry" / "umap_sample.csv",
             OUT_DIR / "01-globalAncestry" / "umap_ref.csv",
             *([OUT_DIR / "01-globalAncestry" / "vae_latent_coords.txt"] if uses_vae() else []),
             OUT_DIR / "01-globalAncestry" / "ancestry_classifications.tsv"]
            if not has_provided_ancestry() else []
        ),
        # ── Local ancestry ──
        lambda wildcards: (
            [OUT_DIR / "02-localAncestry" / "ancestry_full.txt"] +
            expand(OUT_DIR / "02-localAncestry" / "chr{CHR}.lai.msp.tsv", CHR=LOCAL_ANCESTRY_CHROMOSOMES)
            if (not has_provided_ancestry() and uses_local_ancestry()) else []
        ),
        # ── All QC outputs per subset ──
        _qc_outputs_for_subset("full"),
        lambda wildcards: sum(
            (_qc_outputs_for_subset(a) for a in get_ancestries(wildcards)), []
        ),


