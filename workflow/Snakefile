if config.get("releaseFilter", {}).get("enabled", False):
    _rf_targets = [config["releaseFilter"]["keep_list"], config["releaseFilter"]["temp_fam"]]
    # Add filtered derivative outputs
    deriv = config.get("releaseFilter", {}).get("derivatives", {})
    if deriv.get("grm_bin"):
        _rf_targets.extend([
            deriv["grm_bin"] + ".filtered.grm.bin",
            deriv["grm_bin"] + ".filtered.grm.id",
            deriv["grm_bin"] + ".filtered.grm.N.bin",
        ])
    if deriv.get("grm_gz"):
        _rf_targets.append(deriv["grm_gz"].replace(".grm.gz", "_filtered.grm.gz"))
    if deriv.get("eigenvectors"):
        _rf_targets.extend([f + "_filtered" for f in deriv["eigenvectors"]])
    if deriv.get("cnv_files"):
        _rf_targets.extend([f + "_filtered" for f in deriv["cnv_files"]])
    if deriv.get("generic_files"):
        _rf_targets.extend([g["out_path"] if "out_path" in g else g["path"] + "_filtered" for g in deriv["generic_files"]])
    if deriv.get("deidentify_files"):
        _rf_targets.extend([f + "_deid" for f in deriv["deidentify_files"]])

    rule run_releaseFilter:
        threads: 1
        resources:
            nodes=1,
            mem_mb=4000,
            runtime=720,
        input:
            _rf_targets


